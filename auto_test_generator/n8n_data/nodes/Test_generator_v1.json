      ],
      "id": "5642c926-651f-4e89-b776-0f9d33252dee",
      "name": "Converts to .py file"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rag-service:8000/ingest",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "file_path",
              "value": "/data/requirements.pdf"
            }
          ]
        },
        "options": {}
      },
