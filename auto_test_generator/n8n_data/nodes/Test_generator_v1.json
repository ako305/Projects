      ],
      "id": "a783fd64-4bcb-4564-8fb1-02b5ffe3bbab",
      "name": "Ingest pdf into RAG pipeline"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rag-service:8000/query",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "question",
              "value": "Based on the attached requirements PDF, generate a complete Python pytest file. Include test cases for the happy path, edge cases, and error handling for the login and data validation logic. Use clear assertions and mock any external API calls. Just return the python code only without assumptions. The python code should be standalone and should be able to run on its own.\n\nDont put such ```python ``` such statement in the top and bottom. The script should be a standalone pytest script"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        16,
        -32
      ],
      "id": "c651f94a-465a-4d8e-89c1-e007b63618a1",
      "name": "Generate the test case"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rag-service:8000/query",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "=question",
              "value": "=Here is a generated pytest script from the mode:\n{{ $json.answer }}\n\nCross-reference this with the requirements in the uploaded PDF. Check if it correctly tests the 'Happy Path' and if all imports are handled. If there are errors, just list the review points. Else say \"no review points\"."
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -480,
        288
      ],
      "id": "ccf09b05-d4ad-4b19-a4a4-cec1e514d642",
      "name": "Test case reviewer"
    },
